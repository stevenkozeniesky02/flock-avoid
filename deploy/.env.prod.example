# deploy/.env.prod.example — copy to deploy/.env.prod and edit.
# NEVER commit deploy/.env.prod.
#
# Loaded by `docker compose --env-file deploy/.env.prod up`.

# REQUIRED. The public domain the SPA will be served from.
#
# Values:
#   flock-avoid.example.com   real domain → Caddy gets a Let's Encrypt cert
#   :443                      bind to all interfaces on port 443 (advanced)
#   localhost                 use Caddy's internal CA (self-signed cert,
#                             warning page in browser — only for local testing)
FLOCK_DOMAIN=flock-avoid.example.com

# RECOMMENDED. Let's Encrypt sends expiry notifications to this address.
# If you leave it blank, the Caddyfile substitutes a syntactically-valid
# placeholder (admin@change-me.invalid) which Let's Encrypt will refuse to
# issue against; Caddy then falls back to ZeroSSL automatically (which does
# not require an email). Set this if you want Let's Encrypt with proper
# notifications.
FLOCK_ACME_EMAIL=

# OPTIONAL — operator-supplied TLS certificates (alternate to ACME). Use
# when running behind a corporate CA, in an air-gapped environment, or any
# other context where Caddy's automatic HTTPS is not appropriate. To
# activate: uncomment the `(operator_tls)` snippet in
# deploy/Caddyfile.snippets, add `import operator_tls` inside the site
# block of deploy/Caddyfile, and set both paths below to host-side files
# the caddy container can read (bind-mount them via an override compose
# file).
# FLOCK_TLS_CERT_PATH=/etc/ssl/flock/cert.pem
# FLOCK_TLS_KEY_PATH=/etc/ssl/flock/key.pem
